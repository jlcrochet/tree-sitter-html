{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "html",
      "camelcase": "Html",
      "title": "HTML",
      "scope": "source.html",
      "file-types": [
        "html",
        "htm"
      ],
      "external-files": [
        "src/helpers.h",
        "src/tables/html_elements.h",
        "src/tables/mathml_elements.h",
        "src/tables/svg_elements.h",
        "src/tables/html_character_references.h",
        "src/tables/html_character_references_no_semicolon.h",
        "src/xxHash/xxhash.h"
      ],
      "injection-regex": "^html$",
      "class-name": "TreeSitterHtml"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "HTML grammar for Tree-sitter",
    "authors": [
      {
        "name": "Jeffrey Crochet"
      }
    ],
    "links": {
      "repository": "https://github.com/jlcrochet/tree-sitter-html"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}